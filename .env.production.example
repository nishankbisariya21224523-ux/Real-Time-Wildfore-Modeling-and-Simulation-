# ==============================================================================
# Forest Fire Prediction & Spread Simulation Platform - Production Configuration
# ==============================================================================
# IMPORTANT: Never commit production credentials or keys to version control.
# Copy this template to .env.production on deployment hosts and configure with secrets.

# Application Environment
APP_ENV=production
APP_NAME=forest-fire-platform
DEBUG=false
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_MINIMUM_32_CHARACTERS_HEX_KEY

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Restrict CORS strictly to designated production domain(s)
CORS_ORIGINS=https://fire-platform.internal,https://fire-platform.example.gov.in

# PostgreSQL + PostGIS Production Cluster
POSTGRES_USER=forest_admin
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_STRONG_PASSWORD
POSTGRES_DB=forest_fire_db
POSTGRES_HOST=db.internal.forest-fire.lan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forest_admin:CHANGE_ME_PRODUCTION_POSTGRES_STRONG_PASSWORD@db.internal.forest-fire.lan:5432/forest_fire_db

# Redis & Celery Cluster
REDIS_HOST=redis.internal.forest-fire.lan
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_PRODUCTION_REDIS_STRONG_PASSWORD@redis.internal.forest-fire.lan:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_PRODUCTION_REDIS_STRONG_PASSWORD@redis.internal.forest-fire.lan:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_PRODUCTION_REDIS_STRONG_PASSWORD@redis.internal.forest-fire.lan:6379/1

# Spatial Grid & Domain Defaults
DEFAULT_GRID_RESOLUTION_METERS=500
DEFAULT_CRS=EPSG:4326

# Model & Simulation Configuration
RISK_MODEL_ACTIVE_VERSION=risk-xgboost-v001
SPREAD_SIMULATION_MAX_HOURS=12
SPREAD_SIMULATION_TIMEOUT_SECONDS=600

# Frontend (Vite) Production Environment Variables
VITE_API_BASE_URL=https://api.fire-platform.example.gov.in/api/v1
# Optional Mapbox access token if vector tiles are utilized
VITE_MAPBOX_ACCESS_TOKEN=
VITE_DEFAULT_MAP_CENTER_LAT=20.5937
VITE_DEFAULT_MAP_CENTER_LNG=78.9629
VITE_DEFAULT_MAP_ZOOM=5
